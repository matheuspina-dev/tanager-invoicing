# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/tanager?schema=public

# NextAuth.js settings
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Public-facing URL used for password reset links
NEXT_PUBLIC_URL=http://localhost:3000

# Optional: Resend for invoice and password reset emails
# Without these, email sending will fail when used.
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com
